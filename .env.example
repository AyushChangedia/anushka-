# ---------------------------------------------------------------------------
# Recipe Maker AI — environment variables
#
# Copy to `.env.local` and fill in what you need:
#
#   cp .env.example .env.local
#
# EVERY variable here is optional. With none of them set the app still runs:
# it serves the built-in sample recipe corpus, and keeps your pantry, saved
# recipes and shopping list in the browser's local storage. Each variable below
# turns on one additional capability.
# ---------------------------------------------------------------------------


# --- AI recipe generation --------------------------------------------------
# Without this, "Generate recipes" ranks the 10 built-in sample recipes against
# your ingredients instead of writing new ones. Everything else works the same.
#
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=


# --- Database (optional) ---------------------------------------------------
# Enables durable shareable recipe URLs, accounts, and cross-device sync of
# saved recipes. Any PostgreSQL instance works — local, Neon, Supabase, or
# Vercel Postgres.
#
# Local:    postgresql://postgres:postgres@localhost:5432/recipe_maker
# Neon:     postgresql://user:pass@ep-xxx.region.aws.neon.tech/db?sslmode=require
DATABASE_URL=

# Only needed for providers that put a connection pooler in front of Postgres
# (Neon, Supabase, PgBouncer). Prisma migrations need a direct, unpooled
# connection; leave blank if DATABASE_URL is already direct.
DIRECT_URL=


# --- Authentication (optional) ---------------------------------------------
# Sign-in is only offered when AUTH_SECRET plus at least one provider is set.
# Email + password sign-in additionally requires DATABASE_URL.
#
# Generate a secret with:  openssl rand -base64 32
AUTH_SECRET=

# The canonical URL of the deployment. Required in production for OAuth
# callbacks; Vercel sets this automatically, so you usually can leave it blank.
AUTH_URL=

# GitHub OAuth — https://github.com/settings/developers
# Callback URL: {AUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Callback URL: {AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# --- SEO -------------------------------------------------------------------
# Used for canonical URLs, Open Graph tags, sitemap.xml and robots.txt.
# Defaults to http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL=
